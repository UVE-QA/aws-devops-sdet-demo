# Secrets / env
.env
*.env
!.env.example

# Terraform
*.tfstate
*.tfstate.*
.terraform/
# Saved plan files. `-out=tfplan` is the right way to apply exactly what was
# reviewed, and the artifact must not follow the review into git.
#
# `tfplan*` and not `tfplan`, because the rule has to describe the SHAPE of the
# artifact and not the one filename someone happened to type. On 2026-07-26 an
# untracked `infra/public-site/tfplan.tags`, left by the Owner-tag re-apply,
# matched neither `tfplan` (exact) nor `*.tfplan` (suffix) and sat one
# `git add -A` away from the history of a PUBLIC repository.
tfplan*
*.tfplan
.terraform.tfstate.lock.info
crash.log
*.tfvars
!*.tfvars.example

# scripts/watch-page.mjs writes TWO files: <out> is the readable narrative and
# <out>.jsonl is every observation it ever made. The narrative is the record and
# is committed like every other watch log under docs/sessions/. The jsonl is the
# raw material behind it - Phase 30's cycle run alone is 11 MB, larger than the
# whole of docs/ - and CLAUDE.md says large logs do not go in a public repo.
# Nothing reads the jsonl but the person who just ran the instrument.
*.log.jsonl

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
.venv-*/
venv/
*.egg-info/

# Node / Playwright
node_modules/
playwright-report/
test-results/
.playwright/

# OS / editor
.DS_Store
*.swp

# gitleaks report (written by `make secret-scan`, uploaded by CI)
gitleaks-report.json

# Scanner reports (written by `make iac-scan` / `make image-scan`, uploaded by CI)
checkov-report.json
trivy-report.json

# The Lambda deployment package for infra/self-service, built by
# `make self-service-package`. A vendored cryptography wheel is megabytes of
# third-party binary that git has no reason to carry, and its ONLY correct
# version is the one the build produces for the Lambda runtime — a committed
# copy would be a second, staler answer to the same question.
infra/self-service/build/
