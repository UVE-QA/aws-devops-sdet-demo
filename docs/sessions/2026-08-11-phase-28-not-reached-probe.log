  stage.vpc              word="not reached yet"    state="not reached yet · a cycle is under way and has not got here"
  stage.secrets          word="not reached yet"    state="not reached yet · a cycle is under way and has not got here"
  stage.rds              word="not reached yet"    state="not reached yet · a cycle is under way and has not got here"
  stage.alb              word="not reached yet"    state="not reached yet · a cycle is under way and has not got here"
  stage.ecs              word="not reached yet"    state="not reached yet · a cycle is under way and has not got here"
  stage.cloudwatch       word="not reached yet"    state="not reached yet · a cycle is under way and has not got here"
  stage.budgets          word="not reached yet"    state="not reached yet · a cycle is under way and has not got here"
  prod.vpc               word="measured"           state="measured · 24s"
  prod.rds               word="measured"           state="measured · 5m 1s"
  stage.migrate          word="not measured here"  state="not measured here · its step is in Actions, not in a timeline"
exit=0

