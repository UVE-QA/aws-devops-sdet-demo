# Does the map draw `not reached yet` when timeline/stage/nodes-apply.json 404s while a
# cycle about stage is in flight? Asked BEFORE deleting that object from the live bucket.
#
# Throwaway probe, not committed as a gate: it answers one question once. It borrows
# check-page-inflight.mjs's harness - the same static server, the same route mocks, the same
# fixture (tests/fixtures/page-inflight, state in-flight, clock 2026-08-11T04:12:00Z,
# cycle.environments = [stage]) - and renders site/index.html as published.
#
# Sandbox chromium-1194, not the pinned build, and not the devbox. Same caveat Phase 25's
# break tests carried in their own header.
#
# THE ONE PATH ALLOWED TO 404 is /timeline/stage/nodes-apply.json. Any other missing
# document is a refusal, because a page missing more of its layer than intended would
# answer this question for the wrong reason.

## [0] the object absent - the state the deletion will produce
# probe: stage/nodes-apply.json ABSENT
# fixture clock 2026-08-11T04:12:00Z, cycle in flight about ["stage"]
404s served: ["/timeline/stage/nodes-apply.json"]
