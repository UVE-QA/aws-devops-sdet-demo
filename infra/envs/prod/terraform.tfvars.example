# Prod environment variables — EXAMPLE (scaffold mirror of stage).
# Copy to terraform.tfvars and fill in real values. terraform.tfvars is
# gitignored; never commit real values. No secrets here (ADR-0005).
# prod is a scaffold in v0; desired_count defaults to 0.

# Required (no defaults):
owner             = "your-owner-tag"
state_bucket_name = "aws-devops-sdet-demo-tfstate-<demo_account_id>"
budget_email      = "you@example.com"

# Optional overrides (defaults shown):
# region                    = "us-west-2"
# environment               = "prod"
# app_port                  = 8000
# app_image                 = "aws-devops-sdet-demo-app:bootstrap"
# task_cpu                  = 256
# task_memory               = 512
# desired_count             = 0
# log_retention_days        = 14
# db_engine_version         = "16"
# db_instance_class         = "db.t4g.micro"
# github_owner              = "UVE-QA"
# github_repo               = "aws-devops-sdet-demo"
# github_branch             = "main"
# budget_enabled            = true
# monthly_budget_limit      = "20"
# budget_actual_threshold   = 50
# budget_forecast_threshold = 100
