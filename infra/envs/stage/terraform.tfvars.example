# Stage environment variables — EXAMPLE.
# Copy to terraform.tfvars and fill in real values. terraform.tfvars is
# gitignored; never commit real values. Do NOT put secrets here (no DB password,
# no access keys) — the DB password is generated and stored in Secrets Manager
# (ADR-0005). These are safe identifiers only.

# Required (no defaults):
owner             = "your-owner-tag"
state_bucket_name = "aws-devops-sdet-demo-tfstate-<demo_account_id>"
budget_email      = "you@example.com"

# Optional overrides (defaults shown):
# region                    = "us-west-2"
# environment               = "stage"
# app_port                  = 8000
# app_image                 = "aws-devops-sdet-demo-app:bootstrap"
# task_cpu                  = 256
# task_memory               = 512
# desired_count             = 1
# log_retention_days        = 7
# db_engine_version         = "16"
# db_instance_class         = "db.t4g.micro"
# budget_enabled            = true
# monthly_budget_limit      = "20"
# budget_actual_threshold   = 50
# budget_forecast_threshold = 100
