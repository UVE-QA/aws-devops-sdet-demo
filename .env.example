# Local development (docker-compose) — copy to .env, do NOT commit real .env
# App
APP_NAME=aws-devops-sdet-demo

# Database (local docker-compose defaults; RDS uses Secrets Manager instead)
POSTGRES_DB=demo
POSTGRES_USER=demo
POSTGRES_PASSWORD=demo

# SQLAlchemy / Alembic connection string (psycopg2 driver)
DATABASE_URL=postgresql+psycopg2://demo:demo@postgres:5432/demo

# Playwright smoke target
BASE_URL=http://localhost:8000
