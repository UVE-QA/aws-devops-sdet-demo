      "kind": "permanent",
      "shown": true,
      "label": "Route 53 + ACM",
      "service": "route53",
      "why": "delegated zone and the wildcard certificate the ALB serves"
    },
    {
      "id": "perm.site",
      "kind": "permanent",
      "shown": true,
      "label": "S3 + CloudFront — this page",
      "service": "cloudfront",
      "why": "the exhibit cannot be destroyed by the thing it exhibits"
    },
    {
      "id": "perm.selfservice",
      "kind": "permanent",
      "shown": true,
      "label": "Lambda + DynamoDB — the button",
      "service": "lambda",
      "why": "the public launch button, its TTL and its watchdog"
    },

    {
      "id": "vpc",
      "kind": "node",
      "shown": true,
      "label": "VPC",
      "service": "vpc"
    },
    {
      "id": "secrets",
      "kind": "node",
      "shown": true,
      "label": "Secrets Manager",
      "service": "secretsmanager"
    },
    {
      "id": "rds",
      "kind": "node",
      "shown": true,
      "label": "RDS PostgreSQL",
      "service": "rds"
    },
    {
      "id": "alb",
      "kind": "node",
      "shown": true,
      "label": "Application Load Balancer",
      "service": "elb"
    },
    {
      "id": "ecs",
      "kind": "node",
      "shown": true,
      "label": "ECS Fargate",
      "service": "ecs"
    },
    {
      "id": "cloudwatch",
      "kind": "node",
      "shown": true,
      "label": "CloudWatch",
      "service": "cloudwatch"
    },
    {
      "id": "budgets",
      "kind": "node",
      "shown": true,
      "label": "Budgets",
      "service": "budgets"
    },
    {
      "id": "dnsrec",
      "kind": "node",
      "shown": true,
      "label": "Route 53 — app record",
      "service": "route53"
    },

    {
      "id": "adopted-not-created",
      "kind": "hidden",
      "shown": false,
      "label": "adopted, not created",
      "why": "aws_default_security_group does not create anything. The module's own comment says so: AWS makes the group with the VPC and cannot delete it, Terraform adopts it to empty its rules, and a destroy drops it from state. Drawing it beside resources that ARE created would be a claim about creation that the code contradicts."
    }
  ],

  "_repeated": "Resource blocks carrying count or for_each. Each is ONE block and an unknown number of AWS objects, so each has to be acknowledged here by name with the reason; the generator is red on one that appears without an entry, and on an entry whose block no longer repeats. This is why every count in topology.json says resource BLOCKS and not resources - the two differ by exactly this list, and the difference is a fact about variables rather than about the repository.",

  "repeated": {
    "infra/dns::aws_route53_record.validation": "for_each over the wildcard certificate's domain_validation_options — one record per domain ACM asks about",
    "infra/public-site::aws_route53_record.cert_validation": "for_each over the dashboard certificate's domain_validation_options",
    "infra/public-site::aws_route53_record.site_a": "for_each over the apex and www names",
    "infra/public-site::aws_route53_record.site_aaaa": "for_each over the apex and www names",
    "infra/modules/alb::aws_lb_listener.https": "count 0 or 1 — no HTTPS listener without a certificate. Both environments configure one",
    "infra/modules/budgets::aws_budgets_budget.monthly": "count 0 or 1 — the module is instantiated with enabled = false in an environment that does not want its own budget",
    "infra/modules/network::aws_subnet.public": "count = 2 — one public subnet per availability zone",
    "infra/modules/network::aws_subnet.private_db": "count = 2 — the RDS subnet group needs two AZs whether or not anything runs in the second",
    "infra/modules/network::aws_route_table_association.public": "count = 2 — one per public subnet"
  },

