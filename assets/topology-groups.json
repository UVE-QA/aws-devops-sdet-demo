  "phases": [
    {
      "id": "build",
      "n": 1,
      "label": "Build",
      "workflow": "deploy-stage.yml",
      "env": "stage",
      "nodes": [
        {
          "id": "build.ecr",
          "label": "ECR push",
          "service": "ecr",
          "kind": "service",
          "observer": "actions"
        }
      ]
    },
    {
      "id": "stage-apply",
      "n": 2,
      "label": "Apply — stage",
      "workflow": "deploy-stage.yml",
      "env": "stage",
      "level": "infra/envs/stage",
      "nodes": [
        { "group": "vpc" },
        { "group": "secrets" },
        { "group": "rds" },
        { "group": "alb" },
        { "group": "ecs" },
        { "group": "cloudwatch" },
        { "group": "budgets" }
      ]
    },
    {
      "id": "stage-provision",
      "n": 3,
      "label": "Provision — stage",
      "workflow": "deploy-stage.yml",
      "env": "stage",
      "nodes": [
        {
          "id": "stage.migrate",
          "label": "migrate + seed",
          "service": "ecs",
          "kind": "task",
          "observer": "actions"
        }
      ]
    },
    {
      "id": "stage-gate",
      "n": 4,
      "label": "Quality gate — stage",
      "workflow": "deploy-stage.yml",
      "env": "stage",
      "nodes": [
        {
          "id": "suite.db.stage",
          "label": "seed assertion",
          "service": "suite",
          "kind": "suite",
          "observer": "report",
          "suite": "db"
        },
        {
          "id": "suite.api.stage",
          "label": "API contract",
          "service": "suite",
          "kind": "suite",
          "observer": "report",
          "suite": "api"
        },
        {
          "id": "suite.regression.stage",
          "label": "regression",
          "service": "suite",
          "kind": "suite",
          "observer": "report",
          "suite": "regression"
        },
        {
          "id": "suite.smoke.stage",
          "label": "smoke",
          "service": "suite",
          "kind": "suite",
          "observer": "report",
          "suite": "smoke"
        }
      ]
    },
    {
      "id": "approve",
      "n": 5,
      "label": "Approve",
      "workflow": "promote-prod.yml",
      "env": "prod",
      "nodes": [
        {
          "id": "gate.human",
          "label": "a human, in the prod environment",
          "service": "human",
          "kind": "gate",
          "observer": "actions",
          "note": "required reviewer, main only"
        }
      ]
    },
    {
      "id": "prod-apply",
      "n": 6,
      "label": "Apply — prod",
      "workflow": "promote-prod.yml",
      "env": "prod",
      "level": "infra/envs/prod",
      "nodes": [
        { "group": "vpc" },
        { "group": "secrets" },
        { "group": "rds" },
        { "group": "alb" },
        { "group": "ecs" },
        { "group": "cloudwatch" },
        { "group": "dnsrec" },
        { "group": "budgets" }
      ]
    },
    {
      "id": "prod-gate",
      "n": 7,
      "label": "Quality gate — prod",
      "workflow": "promote-prod.yml",
      "env": "prod",
      "nodes": [
        {
          "id": "suite.db.prod",
          "label": "seed assertion",
          "service": "suite",
          "kind": "suite",
          "observer": "report",
          "suite": "db"
        },
        {
          "id": "suite.smoke.prod",
          "label": "smoke",
          "service": "suite",
          "kind": "suite",
          "observer": "report",
          "suite": "smoke"
        }
      ]
    },
    {
      "id": "destroy",
      "n": 8,
      "label": "Destroy",
      "workflow": "destroy.yml",
      "nodes": [
        {
          "id": "destroy.stage",
          "label": "stage — everything above",
          "service": "destroy",
          "kind": "service",
          "env": "stage",
          "observer": "terraform",
          "whole_level": "infra/envs/stage"
        },
        {
          "id": "destroy.prod",
          "label": "prod — everything above",
          "service": "destroy",
          "kind": "service",
          "env": "prod",
          "observer": "terraform",
          "whole_level": "infra/envs/prod"
        }
      ]
    }
  ],

  "suites": {
    "unit": {
      "dir": "tests/unit",
      "pattern": "test_*.py",
      "asserts": "the shape of the log line the 5xx alarm reads, and the scripts a teardown depends on — in-process, no network"
    },
    "db": {
      "dir": "tests/db",
      "pattern": "assert_*.py",
      "asserts": "the seeded rows are in RDS, read from inside the VPC"
    },
    "api": {
      "dir": "tests/api",
      "pattern": "test_*.py",
      "asserts": "the paginated envelope, partial update, request id — DESTRUCTIVE"
    },
    "regression": {
      "dir": "tests/playwright/tests/regression",
      "pattern": "*.spec.ts",
      "asserts": "items and pagination through the UI — DESTRUCTIVE"
    },
    "smoke": {
      "dir": "tests/playwright/tests/smoke",
      "pattern": "*.spec.ts",
      "asserts": "the page loads and the app reaches its database — read-only"
    }
  }
}
